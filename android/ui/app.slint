// Экран «Моей волны» как в официальном Android-клиенте. Размеры в dp сняты с оригинала
// на экране 1080×2400 (420 dpi). Фон с волной рисует OpenGL под окном, поэтому окно прозрачное.

export struct Icons {
    logo: image,
    search: image,
    play: image,
    pause: image,
    like: image,
    liked: image,
    tab-wave: image,
    tab-home: image,
    tab-concerts: image,
    tab-collection: image,
    sparkle: image,
    sparkle-ai: image,
}

export struct WheelCard {
    name: string,
    description: string,
    cover: image,
    round: bool,
    blob: image,
}

component TabIcon inherits Rectangle {
    in property <image> icon;
    in property <color> tint;
    width: 48px;
    height: 48px;
    Image {
        source: icon;
        width: 24px;
        height: 24px;
        colorize: tint;
    }
}

component LoginScreen inherits Rectangle {
    in property <string> code;
    in property <string> hint;
    in property <image> logo;
    callback open-login();
    callback retry();

    Image {
        source: logo;
        y: 58px;
        height: 44px;
        width: 187px;
        colorize: #ff0;
    }
    VerticalLayout {
        y: 260px;
        height: 400px;
        alignment: start;
        spacing: 16px;
        padding-left: 32px;
        padding-right: 32px;
        Text {
            text: "Вход в Яндекс";
            color: #fff;
            font-size: 28px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.code == "" ? "…" : root.code;
            color: #ffdb4d;
            font-family: "YS Display";
            font-size: 44px;
            font-weight: 700;
            letter-spacing: 4px;
            horizontal-alignment: center;
        }
        Text {
            text: root.hint;
            color: #ffffff99;
            font-size: 16px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Rectangle {
            height: 56px;
            border-radius: 28px;
            background: open-ta.pressed ? #e6e600 : #ff0;
            Text {
                text: "Открыть ya.ru/device";
                color: #000;
                font-size: 17px;
                font-weight: 500;
            }
            open-ta := TouchArea {
                clicked => { root.open-login(); }
            }
        }
    }
}

export component App inherits Window {
    background: transparent;
    default-font-family: "YS Text";

    in property <Icons> icons;
    in property <bool> logged-in;
    in property <string> login-code;
    in property <string> login-hint;

    in property <string> track-title;
    in property <bool> playing;
    in property <bool> loading;
    in property <bool> liked;
    in property <float> progress;
    in property <string> status;
    // Факт о текущем треке под плашкой.
    in property <string> fact;
    in property <[WheelCard]> wheel;
    in-out property <length> wheel-offset;

    callback play-pause();
    callback like();
    callback play-wheel(int);
    callback open-login();
    callback retry-login();
    // Плеер что-то поменял: перечитать его состояние.
    callback refresh();

    // Шаг колеса волн: расстояние между центрами соседних карточек.
    out property <length> wheel-spacing: 131px;

    if !root.logged-in: LoginScreen {
        width: root.width;
        height: root.height;
        code: root.login-code;
        hint: root.login-hint;
        logo: root.icons.logo;
        open-login => { root.open-login(); }
        retry => { root.retry-login(); }
    }

    if root.logged-in: Rectangle {
        width: root.width;
        height: root.height;

        // Шапка: логотип по центру и поиск справа.
        Image {
            source: root.icons.logo;
            x: (parent.width - self.width) / 2;
            y: 58px;
            width: 187px;
            height: 44px;
            colorize: #ff0;
        }
        Image {
            source: root.icons.search;
            x: parent.width - 40px - self.width;
            y: 68.5px;
            width: 24px;
            height: 24px;
            colorize: #ffffffe6;
        }

        Text {
            text: "Моя волна";
            x: 0;
            y: 242px;
            width: parent.width;
            horizontal-alignment: center;
            font-family: "YS Music Headline";
            font-weight: 900;
            font-size: 63px;
            color: #fff;
        }

        // Большая кнопка Play.
        play := Rectangle {
            x: (parent.width - 96px) / 2;
            y: 342px;
            width: 96px;
            height: 96px;
            border-radius: 48px;
            background: play-ta.pressed ? #e6e600 : #ff0;
            Image {
                source: root.playing ? root.icons.pause : root.icons.play;
                width: 41.6px;
                height: 41.6px;
                colorize: #000000e6;
            }
            play-ta := TouchArea {
                clicked => { root.play-pause(); }
            }
        }

        // Плашка трека с прогрессом и лайком.
        Rectangle {
            x: 32px;
            y: 450.3px;
            width: parent.width - 64px;
            height: 56px;
            border-radius: 28px;
            clip: true;
            background: #ffffff14;
            Rectangle {
                x: 0;
                width: parent.width * clamp(root.progress, 0, 1);
                height: parent.height;
                background: #ffffff14;
            }
            Text {
                x: 56px;
                width: parent.width - 112px;
                text: root.track-title != "" ? root.track-title : root.status;
                color: #ffffff99;
                font-family: "YS Music Headline";
                font-weight: 700;
                font-size: 17px;
                overflow: elide;
                horizontal-alignment: center;
            }
            Rectangle {
                x: parent.width - 56px;
                width: 56px;
                height: 56px;
                Image {
                    source: root.liked ? root.icons.liked : root.icons.like;
                    width: 24px;
                    height: 24px;
                    colorize: root.liked ? #ff0 : #ffffffcc;
                }
                TouchArea {
                    clicked => { root.like(); }
                }
            }
        }

        // Факт о треке: искра с подписью AI и текст до трёх строк.
        if root.fact != "": Rectangle {
            y: 534.5px;
            width: parent.width;
            height: 80px;
            Rectangle {
                x: 65px - self.width / 2;
                y: 37.5px - self.height / 2;
                width: 180px;
                height: 180px;
                background: @radial-gradient(circle, #ffffff1a 0%, #ffffff00 50%);
            }
            Image {
                source: root.icons.sparkle;
                x: 35.5px;
                y: 26px;
                width: 28px;
                height: 28px;
            }
            Image {
                source: root.icons.sparkle-ai;
                x: 35.5px;
                y: 26px;
                width: 28px;
                height: 28px;
            }
            Text {
                x: 79.6px;
                y: 13px;
                width: 269px;
                height: 55px;
                text: root.fact;
                color: #ffffffe6;
                font-size: 15px;
                font-weight: 500;
                wrap: word-wrap;
                overflow: elide;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Колесо волн: карточки стоят на дуге, средняя выше и крупнее.
        wheel-flick := Flickable {
            y: 600px;
            width: parent.width;
            height: parent.height - self.y;
            content-width: self.width + max(0, root.wheel.length - 1) * root.wheel-spacing;
            content-height: self.height;
            content-x <=> root.wheel-offset;

            for card[i] in root.wheel: card-box := Rectangle {
                // Сдвиг от центра экрана в dp и подъём по дуге радиуса 277.5 dp.
                property <float> d: abs((i * root.wheel-spacing + wheel-flick.content-x) / 1px);
                property <float> arc: min(self.d, 277);
                property <float> scale: 1 - 0.107 * min(self.d / 131, 1);
                property <length> size: 64px * self.scale;
                x: wheel-flick.width / 2 + i * root.wheel-spacing - 67px;
                // Центр обложки на 40 px ниже верха карточки.
                y: 16.8px + (277.5 - sqrt(277.5 * 277.5 - self.arc * self.arc)) * 1px;
                width: 134px;
                height: 200px;

                Image {
                    y: 47px;
                    width: 134px;
                    height: 160px;
                    source: card.blob;
                }
                Rectangle {
                    x: (parent.width - parent.size) / 2;
                    y: 40px - parent.size / 2;
                    width: parent.size;
                    height: parent.size;
                    border-radius: card.round ? self.width / 2 : 8px * parent.scale;
                    clip: true;
                    background: #ffffff14;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: card.cover;
                        image-fit: cover;
                    }
                }
                Rectangle {
                    x: (parent.width - parent.size) / 2;
                    y: 40px - parent.size / 2;
                    width: parent.size;
                    height: parent.size;
                    border-radius: card.round ? self.width / 2 : 8px * parent.scale;
                    border-width: 1px;
                    border-color: #ffffff33;
                }
                VerticalLayout {
                    x: 5px;
                    y: 40px + parent.size / 2 + 3px;
                    width: 124px;
                    alignment: start;
                    spacing: 2px;
                    if card.description != "": Text {
                        text: card.description;
                        color: #ffffff80;
                        font-size: 12px * card-box.scale;
                        font-weight: 500;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: card.name;
                        color: #fff;
                        font-size: 15px * card-box.scale;
                        font-weight: 500;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        overflow: elide;
                        max-height: 40px * card-box.scale;
                    }
                }
                TouchArea {
                    clicked => { root.play-wheel(i); }
                }
            }
        }

        // Нижние вкладки.
        HorizontalLayout {
            y: parent.height - 75.8px;
            height: 48px;
            padding-left: 27.8px;
            padding-right: 27.8px;
            alignment: space-between;
            TabIcon { icon: root.icons.tab-wave; tint: #ff0; }
            TabIcon { icon: root.icons.tab-home; tint: #ffffff80; }
            TabIcon { icon: root.icons.tab-concerts; tint: #ffffff80; }
            TabIcon { icon: root.icons.tab-collection; tint: #ffffff80; }
        }
    }
}
